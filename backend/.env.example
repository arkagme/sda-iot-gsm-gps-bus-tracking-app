# Server Configuration
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/bus-tracker

# Session Secret
SESSION_SECRET=your-super-secret-session-key-change-this

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRE=7d

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Google Maps API Key (for distance calculations)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Admin Email List (comma-separated emails that should be admins)
ADMIN_EMAILS=admin1@sastra.ac.in,admin2@sastra.ac.in

# Allowed Email Domain
ALLOWED_DOMAIN=sastra.ac.in